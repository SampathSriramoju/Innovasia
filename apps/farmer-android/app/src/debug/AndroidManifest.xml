<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      DEBUG MANIFEST MERGE:
      Enables cleartext HTTP and the debug network security config specifically for local developer LAN backends.
      tools:replace ensures this explicitly overrides the release manifest settings only during debug builds.
    -->
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:usesCleartextTraffic" />

</manifest>
